      "css": ".ds-fixed-dock { position: fixed; z-index: 40; inset-inline-start: 50%; inset-block-end: calc(1rem + env(safe-area-inset-bottom, 0px)); width: 17.5rem; max-width: calc(100vw - 1.5rem); height: 3.5rem; display: flex; align-items: center; gap: .25rem; padding: .375rem .75rem; border: 1px solid #2f2e2b; border-radius: var(--radius-pill); background: var(--color-surface); box-shadow: var(--shadow-float); transform: translateX(-50%); } .ds-fixed-dock > b { width: 1px; height: 1rem; margin-inline: .25rem; background: var(--color-line); } .ds-fixed-dock__link { position: relative; width: 2.75rem; height: 2.75rem; flex: 0 0 2.75rem; display: grid; place-items: center; border-radius: var(--radius-pill); color: var(--color-muted); text-decoration: none; transition: background var(--duration-quick) var(--ease-smooth-out), transform var(--duration-quick) var(--ease-smooth-out); } .ds-fixed-dock__link:hover, .ds-fixed-dock__link:focus-visible { background: #22211f; transform: translateY(-1px); } .ds-fixed-dock__link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; } .ds-fixed-dock__icon { width: 1.5rem; height: 1.5rem; opacity: .58; transition: opacity var(--duration-quick) var(--ease-smooth-out); } .ds-fixed-dock__link:hover .ds-fixed-dock__icon, .ds-fixed-dock__link:focus-visible .ds-fixed-dock__icon, .ds-fixed-dock__link--active .ds-fixed-dock__icon { opacity: 1; } .ds-fixed-dock__link i { position: absolute; bottom: .2rem; width: 3px; height: 3px; border-radius: 50%; background: var(--color-ink); } @media (prefers-reduced-motion: reduce) { .ds-fixed-dock__link, .ds-fixed-dock__icon { transition: none; } }"
    },
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "柔白表面上的明确主动作，保持 44px 最小高度。",
      "html": "<button class=\"ds-button-primary\" type=\"button\">继续阅读</button>",
      "css": ".ds-button-primary { min-height: 2.75rem; display: inline-flex; align-items: center; justify-content: center; padding: 0 1rem; border: 1px solid transparent; border-radius: var(--radius-pill); background: var(--color-ink); color: var(--color-canvas); font: 500 var(--text-body)/1 var(--font-sans); box-shadow: var(--shadow-card); cursor: pointer; transition: transform var(--duration-quick) var(--ease-smooth-out), background var(--duration-quick) var(--ease-smooth-out); } .ds-button-primary:hover { transform: translateY(-1px); } .ds-button-primary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; } .ds-button-primary:active { transform: scale(.97); }"
    },
    {
      "name": "次按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "墨黑胶囊表面上的低声量动作。",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">查看归档</button>",
      "css": ".ds-button-secondary { min-height: 2.75rem; display: inline-flex; align-items: center; justify-content: center; padding: 0 1rem; border: 1px solid var(--color-line); border-radius: var(--radius-pill); background: var(--color-surface); color: var(--color-ink); font: 500 var(--text-body)/1 var(--font-sans); cursor: pointer; transition: transform var(--duration-quick) var(--ease-smooth-out), background var(--duration-quick) var(--ease-smooth-out); } .ds-button-secondary:hover { background: var(--color-surface-2); transform: translateY(-1px); } .ds-button-secondary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; } .ds-button-secondary:active { transform: scale(.97); }"
    },
    {
      "name": "出版内容行",
      "kind": "custom",
      "description": "文章和项目归档的默认开放行，使用点状 leader 连接标题和日期。",
      "html": "<a class=\"ds-content-row\" href=\"#article\"><span class=\"ds-content-body\"><strong>设计系统不是组件仓库</strong></span><span class=\"ds-content-leader\" aria-hidden=\"true\"></span><time>2026.08</time></a>",
      "css": ".ds-content-row { min-height: 4rem; display: flex; align-items: center; gap: 1rem; color: var(--color-ink); text-decoration: none; font: 400 var(--text-body)/1.5rem var(--font-sans); } .ds-content-body { min-width: 0; display: grid; gap: .25rem; transition: transform var(--duration-fast) var(--ease-smooth-out); } .ds-content-body strong { font-weight: 500; } .ds-content-leader { min-width: 1.5rem; flex: 1 1 auto; border-top: 1px dotted #4a4845; } .ds-content-row time { color: var(--color-faint); font-variant-numeric: tabular-nums; white-space: nowrap; } .ds-content-row:hover .ds-content-body { transform: translateX(4px); } .ds-content-row:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }"
    },
    {
      "name": "标签",
      "kind": "chip",
      "description": "低对比、非装饰性的紧凑内容标签。",
      "html": "<span class=\"ds-tag\">设计工程</span>",
      "css": ".ds-tag { width: fit-content; display: inline-flex; align-items: center; padding: .22rem .5rem; border: 1px solid var(--color-line); border-radius: var(--radius-xs); color: var(--color-muted); font: 400 var(--text-meta)/1.45 var(--font-sans); }"
