{
  "name": "incessant-leo",
  "version": "0.5.9",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts:subset": "python3 scripts/fonts/subset.py",
    "dev": "npm run fonts:subset && npm run photos:prepare && astro dev",
    "photos:prepare": "node scripts/photos/prepare.mjs",
    "photos:audit": "tsx scripts/photos/audit.ts",
    "test:import": "node --test scripts/import/import.test.mjs",
    "check": "astro check && npm run photos:audit && npm run test:import",
    "build": "npm run photos:prepare && npm run fonts:subset && npm run check && astro build && node scripts/photos/prune-drafts.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^5.0.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@lisse/core": "^0.7.2",
    "astro": "^6.0.0",
    "cuelume": "0.2.4",
    "cuelume-legacy": "npm:cuelume@0.2.2",
    "exiftool-vendored": "^37.2.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tsx": "^4.20.6",
    "turndown": "^7.2.4",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0"
  }
}
