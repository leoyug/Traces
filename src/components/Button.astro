---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "default" | "small";
  type?: "button" | "submit";
  class?: string | null;
}
const { href, variant = "primary", size = "default", type = "button", class: className, ...attributes } = Astro.props;
const classes = ["button", `button--${variant}`, `button--${size}`, className];
---

{href ? <a href={href} class:list={classes} {...attributes}><slot /></a> : <button type={type} class:list={classes} {...attributes}><slot /></button>}
