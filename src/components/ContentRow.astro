---
interface Props {
  title: string;
  summary?: string;
  meta: string;
  href?: string;
  tags?: string[];
}
const { title, summary, meta, href = "#", tags = [] } = Astro.props;
---

<a class="content-row content-row--stack-mobile" href={href}>
  <span class="content-row__body">
    <strong>{title}</strong>
    {summary && <small>{summary}</small>}
    {tags.length > 0 && <span class="tag-list">{tags.map((tag) => <span class="tag">{tag}</span>)}</span>}
  </span>
  <time>{meta}</time>
</a>
