---
interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
  ariaLabel: string;
  className?: string;
  backHref?: string;
  backLabel?: string;
  returnViaHistory?: boolean;
}

const { headings, ariaLabel, className = "", backHref = "/writing/", backLabel = "返回写作", returnViaHistory = false } = Astro.props;
const items = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<aside class:list={["detail-toc", className]} data-detail-toc>
  <a class="detail-toc__back" href={backHref} aria-label={backLabel} data-detail-history-back={returnViaHistory ? "" : undefined}><img src="/assets/figma-v03/detail/back.svg" alt="" /><span>{backLabel}</span></a>
  {items.length > 0 && (
    <nav aria-label={ariaLabel}>
      <ol class="detail-toc__list">
        {items.map((item, index) => (
          <li>
            <a
              class:list={["detail-toc__link", { "is-active": index === 0 }]}
              href={`#${item.slug}`}
              aria-label={item.text}
              aria-current={index === 0 ? "location" : undefined}
              data-detail-toc-link
              data-heading-id={item.slug}
            >
              <span class="detail-toc__label">{item.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}
  <a class="detail-toc__top" href="#main" aria-label="回到顶部"><img src="/assets/figma-v03/detail/to-top.svg" alt="" /><span>回到顶部</span></a>
</aside>

<script>
  type TocRoot = HTMLElement & { detailTocCleanup?: () => void };

  const initializeDetailTocs = () => document.querySelectorAll<TocRoot>("[data-detail-toc]").forEach((toc) => {
    if (toc.dataset.initialized === "true") return;
    toc.dataset.initialized = "true";
    const controller = new AbortController();
    const signal = controller.signal;

    const historyBackLink = toc.querySelector<HTMLAnchorElement>("[data-detail-history-back]");
    if (historyBackLink) {
      try {
        const stored = sessionStorage.getItem("detail-list-return");
        const context = stored ? JSON.parse(stored) as { from?: string; to?: string } : null;
        const target = context?.to ? new URL(context.to) : null;
        const currentPath = location.pathname.replace(/\/+$/, "") || "/";
        const listPath = currentPath.startsWith("/projects/") ? "/projects" : "/writing";
        if (
          target?.origin === location.origin &&
          (target.pathname.replace(/\/+$/, "") || "/") === currentPath &&
          target.search === location.search &&
          (context?.from === "/" || context?.from === listPath)
        ) {
          const label = context.from === "/" ? "返回主页" : listPath === "/projects" ? "返回项目" : "返回写作";
          historyBackLink.href = context.from;
          historyBackLink.setAttribute("aria-label", label);
          const text = historyBackLink.querySelector("span");
          if (text) text.textContent = label;
        }
      } catch {
        // Keep the rendered home link when stored navigation context is unavailable.
      }
    }
    historyBackLink?.addEventListener("click", (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const stored = sessionStorage.getItem("detail-list-return");
      if (!stored) return;

      sessionStorage.removeItem("detail-list-return");
      try {
        const context = JSON.parse(stored) as { from: string; to: string; historyIndex: number };
        const target = new URL(context.to);
        const backPath = new URL(historyBackLink.href).pathname.replace(/\/+$/, "") || "/";
        const currentPath = location.pathname.replace(/\/+$/, "") || "/";
        const isProjectDetail = currentPath.startsWith("/projects/");
        if (
          context.from === backPath &&
          target.origin === location.origin &&
          target.pathname.replace(/\/+$/, "") === currentPath &&
          target.search === location.search &&
          Number.isInteger(context.historyIndex) &&
          Number.isInteger(history.state?.index) &&
          (isProjectDetail ? history.state.index > context.historyIndex : history.state.index === context.historyIndex + 1)
        ) {
          event.preventDefault();
          // Project directory anchors may add entries before returning to the list.
          if (isProjectDetail) history.go(context.historyIndex - history.state.index);
          else history.back();
        }
      } catch {
        // The href remains a usable fallback if stored navigation state is stale.
      }
    }, { signal });

    const links = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>("[data-detail-toc-link]"),
    );
    const entries = links
      .map((link) => {
        const id = link.dataset.headingId;
        const heading = id ? document.getElementById(id) : null;
        return heading ? { link, heading } : null;
      })
      .filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry !== null);

    if (entries.length === 0) {
      toc.detailTocCleanup = () => { controller.abort(); delete toc.dataset.initialized; };
      return;
    }

    let activeIndex = -1;
    let lockedIndex: number | null = null;
    let frame = 0;

    const setActive = (nextIndex: number) => {
      if (nextIndex === activeIndex) return;
      activeIndex = nextIndex;

      entries.forEach(({ link }, index) => {
        const active = index === nextIndex;
        link.classList.toggle("is-active", active);
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };

    const update = () => {
      frame = 0;

      if (lockedIndex !== null) {
        setActive(lockedIndex);
        return;
      }

      const readingLine = Math.min(window.innerHeight * 0.28, 192);
      let nextIndex = 0;

      entries.forEach(({ heading }, index) => {
        if (heading.getBoundingClientRect().top <= readingLine) nextIndex = index;
      });

      const atPageEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      if (atPageEnd) nextIndex = entries.length - 1;
      setActive(nextIndex);
    };

    const requestUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    const releaseLock = () => {
      if (lockedIndex === null) return;
      lockedIndex = null;
      requestUpdate();
    };

    entries.forEach(({ link }, index) => {
      link.addEventListener("click", () => {
        lockedIndex = index;
        setActive(index);
      }, { signal });
    });

    window.addEventListener("scroll", requestUpdate, { passive: true, signal });
    window.addEventListener("resize", requestUpdate, { passive: true, signal });
    window.addEventListener("wheel", releaseLock, { passive: true, signal });
    window.addEventListener("touchstart", releaseLock, { passive: true, signal });
    window.addEventListener("pointerdown", (event) => {
      if (!toc.contains(event.target as Node)) releaseLock();
    }, { passive: true, signal });
    window.addEventListener("keydown", (event) => {
      if (["ArrowDown", "ArrowUp", "PageDown", "PageUp", "Home", "End", " "].includes(event.key)) {
        releaseLock();
      }
    }, { signal });
    update();
    toc.detailTocCleanup = () => {
      controller.abort();
      cancelAnimationFrame(frame);
      delete toc.dataset.initialized;
    };
  });

  initializeDetailTocs();
  document.addEventListener("astro:page-load", initializeDetailTocs);
  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<TocRoot>("[data-detail-toc]").forEach((toc) => toc.detailTocCleanup?.());
  });
</script>
