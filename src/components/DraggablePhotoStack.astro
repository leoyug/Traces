---
import type { Photo } from "../lib/photos";

interface Props {
  photos: Photo[];
  label?: string;
}

const { photos, label = "可拖拽的近期照片" } = Astro.props;
const layouts = [
  { left: "21%", top: "32%", rotate: "-9deg", z: 1 },
  { left: "43%", top: "29%", rotate: "7deg", z: 2 },
  { left: "74%", top: "31%", rotate: "-7deg", z: 7 },
  { left: "43%", top: "70%", rotate: "7deg", z: 3 },
  { left: "23%", top: "70%", rotate: "-8deg", z: 4 },
  { left: "76%", top: "70%", rotate: "9deg", z: 5 },
  { left: "55%", top: "50%", rotate: "-15deg", z: 6 },
] as const;
---

<section class="photo-drag-stack" data-photo-drag-stack aria-label={label}>
  {photos.slice(0, layouts.length).map((photo, index) => {
    const layout = layouts[index];
    return (
      <button
        type="button"
        class:list={["photo-drag-stack__card", `is-${photo.orientation}`]}
        aria-label={`选择照片：${photo.alt}`}
        aria-pressed="false"
        data-photo-drag-card
        style={`--stack-left:${layout.left};--stack-top:${layout.top};--stack-rotate:${layout.rotate};--stack-z:${layout.z}`}
      >
        <span class="photo-drag-stack__image"><img src={photo.src} alt={photo.alt} draggable="false" loading="lazy" /></span>
      </button>
    );
  })}
</section>

<script>
  import { playInterfaceSound } from "../scripts/sound";

  type DragRoot = HTMLElement & { photoDragCleanup?: () => void };

  const initializePhotoDragStacks = () => {
    document.querySelectorAll<DragRoot>("[data-photo-drag-stack]").forEach((stack) => {
      if (stack.dataset.ready === "true") return;
      stack.dataset.ready = "true";

      const canDrag = matchMedia("(hover: hover) and (pointer: fine)");
      const cards = [...stack.querySelectorAll<HTMLButtonElement>("[data-photo-drag-card]")];
      const controller = new AbortController();
      const options = { signal: controller.signal };
      let topLayer = cards.length;

    const selectCard = (selectedCard: HTMLButtonElement) => {
      cards.forEach((card) => {
        const isSelected = card === selectedCard;
        card.toggleAttribute("data-selected", isSelected);
        card.setAttribute("aria-pressed", String(isSelected));
      });
      topLayer += 1;
      selectedCard.style.zIndex = String(topLayer);
    };

    cards.forEach((card) => {
      let pointerId: number | undefined;
      let startX = 0;
      let startY = 0;
      let startLeft = 0;
      let startTop = 0;
      let dragged = false;
      let isPressed = false;

      const releaseCard = () => {
        if (pointerId !== undefined && card.hasPointerCapture(pointerId)) card.releasePointerCapture(pointerId);
        pointerId = undefined;
        card.removeAttribute("data-dragging");
        if (!isPressed) return;
        isPressed = false;
        playInterfaceSound("type", 0.45);
      };

      card.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) return;
        selectCard(card);
        isPressed = true;
        playInterfaceSound("select", 0.75);
        if (!canDrag.matches) return;
        const stackRect = stack.getBoundingClientRect();
        const cardRect = card.getBoundingClientRect();
        pointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        startLeft = cardRect.left - stackRect.left + cardRect.width / 2;
        startTop = cardRect.top - stackRect.top + cardRect.height / 2;
        dragged = false;
        card.setPointerCapture(pointerId);
        card.setAttribute("data-dragging", "");
      }, options);

      card.addEventListener("pointermove", (event) => {
        if (pointerId !== event.pointerId) return;
        const stackRect = stack.getBoundingClientRect();
        const deltaX = event.clientX - startX;
        const deltaY = event.clientY - startY;
        dragged ||= Math.hypot(deltaX, deltaY) > 5;
        if (!dragged) return;

        const cardRect = card.getBoundingClientRect();
        const imageRect = card.querySelector<HTMLSpanElement>(".photo-drag-stack__image")!.getBoundingClientRect();
        // Keep the image inside the board; the paper border may extend beyond
        // its edges and is clipped by the board's overflow.
        const imageOffsetX = imageRect.left + imageRect.width / 2 - (cardRect.left + cardRect.width / 2);
        const imageOffsetY = imageRect.top + imageRect.height / 2 - (cardRect.top + cardRect.height / 2);
        const nextLeft = Math.min(Math.max(startLeft + deltaX, imageRect.width / 2 - imageOffsetX), stackRect.width - imageRect.width / 2 - imageOffsetX);
        const nextTop = Math.min(Math.max(startTop + deltaY, imageRect.height / 2 - imageOffsetY), stackRect.height - imageRect.height / 2 - imageOffsetY);
        card.style.setProperty("--stack-left", `${(nextLeft / stackRect.width) * 100}%`);
        card.style.setProperty("--stack-top", `${(nextTop / stackRect.height) * 100}%`);
        event.preventDefault();
      }, options);

      card.addEventListener("pointerup", releaseCard, options);
      card.addEventListener("pointercancel", releaseCard, options);
      card.addEventListener("keydown", (event) => {
        if (event.repeat || (event.key !== " " && event.key !== "Enter")) return;
        isPressed = true;
        playInterfaceSound("select", 0.75);
      }, options);
      card.addEventListener("keyup", (event) => {
        if (event.key !== " " && event.key !== "Enter") return;
        releaseCard();
      }, options);
      card.addEventListener("click", () => selectCard(card), options);
    });

      stack.photoDragCleanup = () => {
        controller.abort();
        stack.removeAttribute("data-ready");
      };
    });
  };

  initializePhotoDragStacks();
  document.addEventListener("astro:page-load", initializePhotoDragStacks);
  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<DragRoot>("[data-photo-drag-stack]").forEach((stack) => stack.photoDragCleanup?.());
  });
</script>

<style>
  .photo-drag-stack {
    position: relative;
    aspect-ratio: 841 / 558;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--color-photo-board-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-photo-board-bg);
    background-image: radial-gradient(circle, var(--color-photo-board-dot) 0.8px, transparent 1.25px);
    background-size: 18px 18px;
  }

  .photo-drag-stack__card {
    --photo-card-width: clamp(5.5rem, 22%, 8.5rem);
    position: absolute;
    top: var(--stack-top);
    left: var(--stack-left);
    z-index: var(--stack-z);
    width: var(--photo-card-width);
    padding: 0.625rem 0.625rem 1.75rem;
    background: var(--color-photo-paper);
    box-shadow: var(--shadow-card);
    color: var(--color-ink);
    border: 0;
    cursor: grab;
    transform: translate(-50%, -50%) rotate(calc(var(--stack-rotate) + var(--photo-card-rotation, 0deg)));
    touch-action: none;
    user-select: none;
  }

  .photo-drag-stack__card[data-dragging] { cursor: grabbing; }
  .photo-drag-stack__card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }

  .photo-drag-stack__image {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .photo-drag-stack__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .photo-drag-stack__card.is-landscape { --photo-card-rotation: 90deg; }
  .photo-drag-stack__card.is-landscape img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 125%;
    height: 80%;
    max-width: none;
    transform: translate(-50%, -50%) rotate(-90deg);
  }

  @media (max-width: 47.999rem), (hover: none), (pointer: coarse) {
    .photo-drag-stack__card { --photo-card-width: clamp(3.75rem, 19%, 5rem); padding: 0.375rem 0.375rem 1rem; cursor: pointer; touch-action: pan-y; }
  }
</style>
