---
import lightSvg from "../assets/pixel-person/light.svg?raw";
import darkSvg from "../assets/pixel-person/dark.svg?raw";

// Isolate the supplied SVG selectors, clip paths and keyframes for every instance.
const namespace = `pixel-${crypto.randomUUID()}`;
const isolateSvg = (source: string, theme: string) => {
  const prefix = `${namespace}-${theme}-`;
  const ids = Array.from(source.matchAll(/id="([^"]+)"/g), (match) => match[1]);
  for (const id of ids) {
    source = source.replaceAll(`id="${id}"`, `id="${prefix}${id}"`);
    source = source.replaceAll(`#${id}`, `#${prefix}${id}`);
  }
  return source.replace(/\bkf_[\w-]+/g, (name) => `${prefix}${name}`);
};
---

<span class="pixel-person-preview" aria-hidden="true">
  <span class="pixel-person-preview__light" set:html={isolateSvg(lightSvg, "light")} />
  <span class="pixel-person-preview__dark" set:html={isolateSvg(darkSvg, "dark")} />
</span>

<style>
  .pixel-person-preview {
    position: absolute;
    bottom: calc(100% - var(--pixel-person-preview-offset));
    left: 50%;
    width: var(--pixel-person-preview-size);
    height: var(--pixel-person-preview-size);
    transform: translate(-50%, var(--pixel-person-preview-travel));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-smooth-out), opacity var(--duration-fast) var(--ease-smooth-out), visibility 0s var(--duration-fast);
  }
  .pixel-person-preview__light, .pixel-person-preview__dark { display: block; width: 100%; height: 100%; }
  .pixel-person-preview__dark { display: none; }
  :global([data-theme="dark"]) .pixel-person-preview__light { display: none; }
  :global([data-theme="dark"]) .pixel-person-preview__dark { display: block; }
  .pixel-person-preview :global(svg) { display: block; width: 100%; height: 100%; }
  .pixel-person-preview :global(svg *) { animation-play-state: paused !important; }
  :global(.dashed-underline--pixel-person:focus-visible) .pixel-person-preview {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
    transition: transform var(--duration-project-attribute) var(--ease-smooth-out), opacity var(--duration-project-attribute) var(--ease-smooth-out), visibility 0s;
  }
  :global(.dashed-underline--pixel-person:focus-visible) .pixel-person-preview :global(svg *) { animation-play-state: running !important; }
  @media (hover: hover) and (pointer: fine) {
    :global(.dashed-underline--pixel-person:hover) .pixel-person-preview {
      visibility: visible;
      opacity: 1;
      transform: translate(-50%, 0);
      transition: transform var(--duration-project-attribute) var(--ease-smooth-out), opacity var(--duration-project-attribute) var(--ease-smooth-out), visibility 0s;
    }
    :global(.dashed-underline--pixel-person:hover) .pixel-person-preview :global(svg *) { animation-play-state: running !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pixel-person-preview {
      transform: translate(-50%, 0) !important;
      transition: none !important;
    }
    .pixel-person-preview :global(svg *) { animation: none !important; }
  }
</style>
