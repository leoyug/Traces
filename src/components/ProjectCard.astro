---
import TextLink from "./TextLink.astro";

interface Props {
  title: string;
  summary: string;
  year?: string | number;
  status?: string;
  accent: string;
  href?: string;
  image?: string;
}
const { title, summary, year, status, accent, href = "/projects", image } = Astro.props;
const linkLabel = ["查看项目", title, year, status].filter(Boolean).join("，");
---

<article class="project-card" data-list-sound>
  <a class:list={["project-card__visual", `tone-${accent}`]} data-smooth-corners="surface" href={href} aria-label={linkLabel}>
    {image ? <img data-smooth-corners="clip" src={image} alt="" loading="lazy" /> : (
      <span class="project-card__preview">
        <span class="project-card__chrome"></span>
        <span class="project-card__screen">
          <span class="project-card__document"></span>
          <span class="project-card__sidebar"></span>
        </span>
      </span>
    )}
  </a>
  <div class="project-card__body">
    <div class="project-card__heading"><h3><TextLink href={href} underline="reveal">{title}</TextLink></h3></div>
    <p>{summary}</p>
  </div>
</article>
