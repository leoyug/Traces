---
import TextLink from "./TextLink.astro";

interface Props {
  title: string;
  summary: string;
  year: string | number;
  status: string;
  accent: string;
  href?: string;
  image?: string;
}
const { title, summary, year, status, accent, href = "/projects", image } = Astro.props;
---

<article class="project-card">
  <a class:list={["project-card__visual", `tone-${accent}`]} href={href} aria-label={`查看项目：${title}，${year}，${status}`}>
    {image ? <img src={image} alt="" loading="lazy" /> : (
      <span class="project-card__preview">
        <span class="project-card__chrome"></span>
        <span class="project-card__screen">
          <span class="project-card__document"></span>
          <span class="project-card__sidebar"></span>
        </span>
      </span>
    )}
  </a>
  <div class="project-card__body">
    <div class="project-card__heading"><h3><TextLink href={href} underline="reveal">{title}</TextLink></h3></div>
    <p>{summary}</p>
  </div>
</article>
