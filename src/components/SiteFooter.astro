---
interface Props { articleDetail?: boolean; }
const { articleDetail = false } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>{articleDetail ? "© 2026  步履不停" : "© 2026 Leo. -  步履不停"}</p>
    <img src={articleDetail ? "/assets/figma-v03/article-detail/footer-logo.svg" : "/assets/figma/leo-mark.svg"} alt="" width="64" height="48" />
  </div>
</footer>
