---
import TextLink from "./TextLink.astro";
import { getEntry } from "astro:content";

interface Props { variant?: "default" | "detail"; }
const { variant = "default" } = Astro.props;

const resume = await getEntry("resume", "main");
if (!resume) throw new Error("缺少 main 职业履历内容");
const x = resume.data.links.find((link) => link.label === "X/Twitter")?.href;
const github = resume.data.links.find((link) => link.label === "GitHub")?.href;
---

<footer class:list={["site-footer", { "site-footer--detail": variant === "detail" }]}>
  <div class="site-footer__inner">
    {variant === "detail" ? <><p>© 2026 Leo</p><img src="/assets/figma-v03/article-detail/leo-mark.svg" alt="" width="64" height="48" /></> : <>
    <nav class="site-footer__links" aria-label="页脚导航">
      <div><TextLink href="/resume">简历</TextLink><TextLink href="/rss.xml">RSS</TextLink></div>
      <div><TextLink href="/inspiration">灵感</TextLink>{x && <TextLink href={x}>X.com</TextLink>}</div>
      <div><TextLink href="/experiments">试验</TextLink>{github && <TextLink href={github} rel="me">GitHub</TextLink>}</div>
      <div><TextLink href="/thanks">致谢</TextLink><TextLink href={`mailto:${resume.data.email}`}>Email</TextLink></div>
    </nav>
    <div class="site-footer__brand">
      <img src="/assets/figma/leo-mark.svg" alt="" width="64" height="48" />
      <p>© 2026 Leo</p>
    </div>
    </>}
  </div>
</footer>
