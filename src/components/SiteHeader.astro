---
import { navigation } from "../data/site";
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === "/") return currentPath === "/";
  if (href === "/photos") return currentPath.startsWith("/photos") || currentPath.startsWith("/albums") || currentPath.startsWith("/gallery");
  return currentPath.startsWith(href);
};
---

<nav class="floating-nav" aria-label="主要导航">
  {navigation.map((item, index) => (
    <>
      {index === 1 && <span class="floating-nav__divider" aria-hidden="true"></span>}
      <a
        href={item.href}
        class:list={["floating-nav__link", { "is-active": isCurrent(item.href) }]}
        aria-label={item.label}
        aria-current={isCurrent(item.href) ? "page" : undefined}
      >
        <img src={item.icon} alt="" width="24" height="24" />
        <span class="floating-nav__tooltip" aria-hidden="true">{item.label}</span>
        <span class="floating-nav__dot" aria-hidden="true"></span>
      </a>
    </>
  ))}
</nav>
