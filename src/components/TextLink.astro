---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  underline?: "fade" | "reveal";
}

const { href, underline = "fade", class: className, ...attributes } = Astro.props;
---

<a href={href} class:list={["text-link", `text-link--${underline}`, className]} {...attributes}><slot /></a>
