---
import type { GalleryPhoto } from "../../lib/gallery";
import PlaySpinLoader from "../PlaySpinLoader.astro";
import PhotoCornerMarks from "./PhotoCornerMarks.astro";

interface Props {
  photos: GalleryPhoto[];
  initialSlug?: string;
}

const { photos: galleryPhotos, initialSlug } = Astro.props;
if (galleryPhotos.length === 0) throw new Error("摄影页面需要至少一张已发布的照片");
const initialPhoto = galleryPhotos.find((photo) => photo.slug === initialSlug) ?? galleryPhotos[0];
const serialized = JSON.stringify(galleryPhotos).replaceAll("<", "\\u003c");
const desktopColumns = [galleryPhotos.slice(0, 5), galleryPhotos.slice(5, 10), galleryPhotos.slice(10)];
const mobileColumnIndexes = [
  [0, 1, 10, 3, 4],
  [5, 6, 11, 2, 7, 8, 13],
];
const mobileColumns = mobileColumnIndexes.map((indexes) => indexes.map((index) => galleryPhotos[index]).filter((photo): photo is GalleryPhoto => Boolean(photo)));
const placed = new Set(mobileColumnIndexes.flat());
galleryPhotos.forEach((photo, index) => {
  if (!placed.has(index)) mobileColumns[index % 2].push(photo);
});
---

<div class="photo-gallery" data-photo-gallery data-initial-slug={initialSlug}>
  <header class="photo-index-header reading-column"><h1>摄影</h1><p>关于时光、地点、所见事物的存档。</p></header>
  <section class="gallery-grid gallery-grid--desktop reading-column" aria-label="摄影作品">
    {desktopColumns.map((column) => (
      <div class="gallery-column">
        {column.map((photo) => {
          const index = galleryPhotos.indexOf(photo);
          return (
            <a class:list={[`is-${photo.size}`, "photo-hover-target", index % 4 < 2 ? "turn-left" : "turn-right"]} href={`/photos/${photo.slug}/`} data-gallery-photo data-photo-index={index}>
              <img class="photo-hover-image" src={photo.src} alt={photo.alt} loading={index < 6 ? "eager" : "lazy"} />
              <PhotoCornerMarks />
            </a>
          );
        })}
      </div>
    ))}
  </section>
  <section class="gallery-grid gallery-grid--mobile reading-column" aria-label="摄影作品">
    {mobileColumns.map((column) => (
      <div class="gallery-column">
        {column.map((photo) => {
          const index = galleryPhotos.indexOf(photo);
          return (
            <a class:list={[`is-${photo.size}`, "photo-hover-target", index % 4 < 2 ? "turn-left" : "turn-right"]} href={`/photos/${photo.slug}/`} data-gallery-photo data-photo-index={index}>
              <img class="photo-hover-image" src={photo.src} alt={photo.alt} loading={index < 6 ? "eager" : "lazy"} />
              <PhotoCornerMarks />
            </a>
          );
        })}
      </div>
    ))}
  </section>

  <dialog
    class="photo-lightbox"
    aria-label="照片详情，点击任意区域关闭"
    data-photo-lightbox
    tabindex="-1"
  >
    <div class="photo-lightbox__shell">
      <div class="photo-lightbox__stage">
        <PlaySpinLoader deferred />
        <figure class="photo-lightbox__frame">
          <img class="photo-lightbox__corner is-top-left" src="/assets/figma-v03/photo-lightbox/corner-top-left.svg" alt="" />
          <img class="photo-lightbox__corner is-top-right" src="/assets/figma-v03/photo-lightbox/corner-top-right.svg" alt="" />
          <img class="photo-lightbox__corner is-bottom-left" src="/assets/figma-v03/photo-lightbox/corner-bottom-left.svg" alt="" />
          <img class="photo-lightbox__corner is-bottom-right" src="/assets/figma-v03/photo-lightbox/corner-bottom-right.svg" alt="" />
          <img class="photo-lightbox__image" src={initialPhoto.src} alt={initialPhoto.alt} data-photo-lightbox-image />
        </figure>
      </div>
      <dl class="photo-lightbox__facts">
        {initialPhoto.facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    </div>
  </dialog>
  <script is:inline type="application/json" data-gallery-data set:html={serialized}></script>
</div>

<script>
  import "../../scripts/gallery-lightbox";
</script>
