---
import type { PhotoListItem } from "../../lib/photo-types";

interface Props {
  photo: PhotoListItem;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
}

const {
  photo,
  class: className,
  loading = "lazy",
  fetchpriority = "auto",
  sizes = "(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw",
} = Astro.props;
const webp = photo.sources.webp.map((variant) => `${variant.src} ${variant.width}w`).join(", ");
const jpeg = photo.sources.jpeg.map((variant) => `${variant.src} ${variant.width}w`).join(", ");
const fallback = photo.sources.jpeg.at(-1)!;
---

<picture>
  <source type="image/webp" srcset={webp} sizes={sizes} />
  <img
    class={className}
    src={fallback.src}
    srcset={jpeg}
    sizes={sizes}
    width={photo.width}
    height={photo.height}
    alt={photo.alt}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
