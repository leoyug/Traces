---
import type { Photo } from "../../lib/photos";
import PlaySpinLoader from "../PlaySpinLoader.astro";
import PhotoCornerMarks from "./PhotoCornerMarks.astro";

interface Props {
  photos: Photo[];
  initialSlug?: string;
}

const { photos, initialSlug } = Astro.props;
if (photos.length === 0) throw new Error("摄影页面需要至少一张已发布的照片");
const initialPhoto = photos.find((photo) => photo.slug === initialSlug) ?? photos[0];
const serialized = JSON.stringify(photos).replaceAll("<", "\\u003c");
// Match the fixed tile heights and gap in site.css; mobile keeps the same two ratios.
const tileHeights = { tall: 296, short: 134 } as const;
const tileGap = 12;
const balanceColumns = (count: number) => {
  const columns = Array.from({ length: count }, () => [] as Photo[]);
  const heights = Array<number>(count).fill(0);

  for (const photo of photos) {
    const shortest = heights.indexOf(Math.min(...heights));
    heights[shortest] += tileHeights[photo.size] + (columns[shortest].length ? tileGap : 0);
    columns[shortest].push(photo);
  }

  return columns;
};
const desktopColumns = balanceColumns(3);
const mobileColumns = balanceColumns(2);
---

<div class="photos-page" data-photos-page data-initial-slug={initialSlug}>
  <header class="photo-index-header reading-column"><h1>摄影</h1><p>关于时光、地点、所见事物的存档。</p></header>
  <section class="photos-grid photos-grid--desktop reading-column" aria-label="摄影作品">
    {desktopColumns.map((column) => (
      <div class="photos-column">
        {column.map((photo) => {
          const index = photos.indexOf(photo);
          return (
            <a class:list={[`is-${photo.size}`, "photo-hover-target", index % 4 < 2 ? "turn-left" : "turn-right"]} href={`/photos/${photo.slug}/`} data-photo-link data-photo-index={index}>
              <img class="photo-hover-image" src={photo.src} alt={photo.alt} loading={index < 6 ? "eager" : "lazy"} />
              <PhotoCornerMarks />
            </a>
          );
        })}
      </div>
    ))}
  </section>
  <section class="photos-grid photos-grid--mobile reading-column" aria-label="摄影作品">
    {mobileColumns.map((column) => (
      <div class="photos-column">
        {column.map((photo) => {
          const index = photos.indexOf(photo);
          return (
            <a class:list={[`is-${photo.size}`, "photo-hover-target", index % 4 < 2 ? "turn-left" : "turn-right"]} href={`/photos/${photo.slug}/`} data-photo-link data-photo-index={index}>
              <img class="photo-hover-image" src={photo.src} alt={photo.alt} loading={index < 6 ? "eager" : "lazy"} />
              <PhotoCornerMarks />
            </a>
          );
        })}
      </div>
    ))}
  </section>

  <dialog
    class="photo-lightbox"
    aria-label="照片详情，点击任意区域关闭"
    data-photo-lightbox
    tabindex="-1"
  >
    <div class="photo-lightbox__shell">
      <div class="photo-lightbox__stage">
        <PlaySpinLoader deferred />
        <figure class="photo-lightbox__frame">
          <img class="photo-lightbox__corner is-top-left" src="/assets/figma-v03/photo-lightbox/corner-top-left.svg" alt="" />
          <img class="photo-lightbox__corner is-top-right" src="/assets/figma-v03/photo-lightbox/corner-top-right.svg" alt="" />
          <img class="photo-lightbox__corner is-bottom-left" src="/assets/figma-v03/photo-lightbox/corner-bottom-left.svg" alt="" />
          <img class="photo-lightbox__corner is-bottom-right" src="/assets/figma-v03/photo-lightbox/corner-bottom-right.svg" alt="" />
          <img class="photo-lightbox__image" src={initialPhoto.src} alt={initialPhoto.alt} data-photo-lightbox-image />
        </figure>
      </div>
      <dl class="photo-lightbox__facts">
        {initialPhoto.facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
      </dl>
    </div>
  </dialog>
  <script is:inline type="application/json" data-photos-data set:html={serialized}></script>
</div>

<script>
  import "../../scripts/photos-lightbox";
</script>
