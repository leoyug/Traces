---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  socialImage?: string | null;
  robots?: string;
}

const {
  title = "Rush Leo｜设计工程与长期记录",
  description = "一个关于设计工程、写作与摄影的长期个人档案。",
  wide = false,
  socialImage = "/og-ian-inspired.png",
  robots,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const resolvedSocialImage = socialImage ? new URL(socialImage, Astro.site) : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#191918" />
    <link rel="icon" href="/favicon-leo.png" type="image/png" sizes="240x240" />
    <link rel="apple-touch-icon" href="/favicon-leo.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {resolvedSocialImage && <meta property="og:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta property="og:image:width" content="1536" />}
    {resolvedSocialImage && <meta property="og:image:height" content="1024" />}
    <meta name="twitter:card" content={resolvedSocialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedSocialImage && <meta name="twitter:image" content={resolvedSocialImage} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <!-- THESIS: 深夜背景中的一条安静出版栏，把工作、写作与摄影放在同一条长期记录里。 OWN-WORLD: 近黑画布、640px 窄栏、手写标记、灰阶文字与原比例摄影。 STORY: 访客先认识 Leo，再依次进入文章、项目与照片，固定在屏幕底部的胶囊导航持续提供方向。 FIRST VIEWPORT: 签名与三行介绍从 64px 开始，正文在首屏直接给出项目、写作和摄影入口。 FORM: Figma V0.3 的深色个人出版物。 FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
    <a class="skip-link" href="#main">跳到主要内容</a>
    <SiteHeader />
    <main id="main" class:list={["page-main", { "page-main--wide": wide }]}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
