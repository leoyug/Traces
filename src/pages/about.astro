---
import BaseLayout from "../layouts/BaseLayout.astro";
import ParticlePortrait from "../components/ParticlePortrait.astro";
import TextLink from "../components/TextLink.astro";
import { getEntry } from "astro:content";

const resume = await getEntry("resume", "main");
if (!resume) throw new Error("缺少 main 职业履历内容");
const github = resume.data.links.find((link) => link.label === "GitHub")?.href;
const x = resume.data.links.find((link) => link.label === "X/Twitter")?.href;
const xiaohongshu = resume.data.links.find((link) => link.label === "小红书")?.href;
---

<BaseLayout title="关于｜Leo" description="设计工程师 Leo 的个人介绍。">
  <header class="about-intro reading-column">
    <h1 data-route-enter>关于我</h1>
    <div class="about-intro__body">
      <div class="about-intro__copy" data-route-enter-group>
        <p>你好，我是Leo，一名设计工程师。</p>
        <p>我喜欢探索精致的界面、有趣的功能、顺畅的动效，以及所有用心创作的事物，并始终致力于打造既实用又赏心悦目的产品。最近，我开始更多地利用 AI 来实现自己的想法，并尝试将其融入日常工作流中。</p>
        <p>工作之余，我会和万万一起带着相机到处走走拍拍，也享受创作、游戏、漫画和电影带来的乐趣。</p>
        <p>目前我正在寻找全职工作，这是我的<TextLink href="/resume">简历</TextLink>。你可以在 {x && <TextLink href={x}>X</TextLink>}、{github && <TextLink href={github} rel="me">GitHub</TextLink>}、{xiaohongshu && <TextLink href={xiaohongshu}>小红书</TextLink>}上找到我，或随时给我发送<TextLink href={`mailto:${resume.data.email}`}>邮件</TextLink>。</p>
      </div>
      <ParticlePortrait class="about-portrait" src="/assets/figma-v03/about/portrait-particles.webp" alt="Leo 的像素风肖像" />
    </div>
  </header>
  <div class="about-sections reading-column" data-route-enter-group>
    <section><h2>最近在忙</h2>
      <ul class="plain-list">
        <li>👨🏻‍💻正在研究将 AI 融入到日常设计工作中</li>
        <li>🚶走到哪，📷拍到哪</li>
        <li>📺在看《真探》</li>
        <li>🎮通关《杀戮尖塔 2》</li>
        <li>🏋🏻减到 65kg</li>
        <li>🥲在大A回本</li>
        <li>👫🏻和万万一起去到别的地方，体验各种事物，拍美好的景物，吃好吃的美食</li>
      </ul></section>

  </div>
</BaseLayout>
