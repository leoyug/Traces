---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import ContentRow from "../components/ContentRow.astro";
import ContactLinks from "../components/ContactLinks.astro";
import DetailToc from "../components/DetailToc.astro";
import ArticleImageZoom from "../components/ArticleImageZoom.astro";
import DraggablePhotoStack from "../components/DraggablePhotoStack.astro";
import PhotoFanStack from "../components/PhotoFanStack.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ParticlePortrait from "../components/ParticlePortrait.astro";
import PlaySpinLoader from "../components/PlaySpinLoader.astro";
import ProgressiveBlur from "../components/ProgressiveBlur.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TextLink from "../components/TextLink.astro";
import AnimatedHighlight from "../components/AnimatedHighlight.astro";
import DashedUnderline from "../components/DashedUnderline.astro";
import { aiLogos } from "../data/site";
import { getPhotos } from "../lib/photos";
import { getPhotoStackPhotos } from "../lib/photo-stack";

if (import.meta.env.PROD) return Astro.redirect("/");
const photos = await getPhotos();
const stackPhotos = await getPhotoStackPhotos();

const colorGroups = [
  {
    title: "基础表面",
    description: "定义页面、容器与图片材质的层级。",
    tokens: [
      ["canvas", "页面最底层背景"],
      ["surface", "导航、卡片等基础表面"],
      ["surface-2", "嵌套表面与局部层级"],
      ["surface-felt", "照片拖拽板的底"],
      ["photo-paper", "拍立得相纸边框"],
    ],
  },
  {
    title: "内容层级",
    description: "从高强调标题到低优先级说明，保持阅读层级一致。",
    tokens: [
      ["ink", "标题与高强调信息"],
      ["copy", "连续正文与描述文字"],
      ["link", "正文内可点击链接"],
      ["muted", "区块小标题与辅助信息"],
      ["faint", "低优先级元数据"],
      ["contact", "联系模块链接"],
      ["on-dark", "深色背景上的反白文字"],
    ],
  },
  {
    title: "边界与结构",
    description: "用较弱的线条区分区域，而不抢占内容层级。",
    tokens: [
      ["line", "常规分割线与边框"],
      ["line-subtle", "浮层和提示的弱边框"],
      ["leader", "目录与时间线引导线"],
      ["contact-underline", "联系链接默认下划线"],
      ["contact-underline-active", "联系链接交互下划线"],
    ],
  },
  {
    title: "强调与交互",
    description: "保留青绿色主色，并让控件默认、悬停和选中态共享同一套语义。",
    tokens: [
      ["accent", "焦点、当前状态与必要强调"],
      ["accent-ink", "强调色上的深色文字"],
      ["accent-soft", "选择和提示的柔和底色"],
      ["control-idle", "控件默认文字与图标"],
      ["control-emphasis", "控件悬停与聚焦前景"],
      ["control-selected", "控件选中背景"],
      ["control-selected-ink", "控件选中前景"],
    ],
  },
] as const;
const spaces = [1, 2, 3, 4, 5, 6, 8, 12, 16];
const tocHeadings = [
  { depth: 2, slug: "toc-demo-context", text: "背景与约束" },
  { depth: 2, slug: "toc-demo-decisions", text: "设计判断与实现取舍" },
  { depth: 2, slug: "toc-demo-reflection", text: "结果与反思" },
];
const fanPhotoLabels = ["夜行", "栈桥", "帐篷", "散步", "晚风", "树影", "远望"];
const fanPhotos = photos.slice(0, 7).map((photo, index) => ({ photo, label: fanPhotoLabels[index] }));
---

<BaseLayout title="设计系统预览（开发环境）｜Rush Leo">
  <header class="page-intro wide-column ds-intro">
    <h1>不息设计系统</h1>
    <p>从项目调研中提取的暖纸色、克制排版与低层级表面。这个页面只在开发环境呈现，用于验证变量和组件复用。</p>
  </header>
  <div class="ds-stack wide-column">
    <section>
      <SectionHeading title="颜色系统" description="按表面、内容、边界与交互分层；切换外观后，色块与实际值会同步更新。" />
      <div class="color-groups">
        {colorGroups.map((group) => (
          <section class="color-group" aria-labelledby={`color-group-${group.title}`}>
            <div class="color-group__heading">
              <h3 id={`color-group-${group.title}`}>{group.title}</h3>
              <p>{group.description}</p>
            </div>
            <div class="swatch-grid">
              {group.tokens.map(([color, rule]) => (
                <article class="swatch">
                  <div class="swatch__color" style={`background:var(--color-${color})`}></div>
                  <code>--color-{color}</code>
                  <p>{rule}</p>
                  <output data-color-token={color}>读取中</output>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
    <section><SectionHeading title="正文与链接颜色" description="正文与链接都使用语义 token，并随亮暗模式同步映射。" /><div class="text-color-demo"><p>普通文字用于连续阅读的段落；<TextLink href="/writing">链接文字</TextLink>用于可点击的内容。</p><code>--color-copy · <output data-color-token="copy">读取中</output></code><code>--color-link · <output data-color-token="link">读取中</output></code></div></section>
    <section><SectionHeading title="动态文字高亮" description="悬停时沿用 Figma 黑色白边箭头光标；悬停或键盘聚焦时，鼠标图标依次描绘线条并显示淡色高亮；减少动态效果时保留静态图标。" /><p>你好，我是Leo，一名<AnimatedHighlight>设计工程师</AnimatedHighlight>。</p></section>
    <section><SectionHeading title="虚线下划线 · DashedUnderline" description="用于正文关键词的静态强调，文字使用链接色、继承字号并支持换行；文字与线色随主题 token 映射；Figma 示例启用 selection 悬停选中框；动效示例启用 wave 流动波浪下划线，键盘聚焦同样触发，减少动态效果时静态显示；AI 示例启用 logos，三枚图片错开向上弹出，离开时收回；走走拍拍示例启用 photo-stack，悬停预览三张照片，文字不响应点击，悬停卡片进一步展开，点击堆叠展开六张照片，按下单张轻微缩小，松开后查看完整照片，其余照片保留在模糊遮罩后；详情仅由底部关闭按钮退出，图库也可按 Esc 关闭，图库收回时由原来的三张预览卡片归位并淡出；圆角始终为短边的 16%，照片按原始比例裁切，过渡只改变裁切窗口，避免拉伸。" /><p>我使用 <DashedUnderline effect="selection">Figma</DashedUnderline> 进行设计，使用 <DashedUnderline effect="pixel-person">Codex</DashedUnderline> 进行构建，喜欢<DashedUnderline effect="wave">动效</DashedUnderline>与<DashedUnderline>用心创作的事物</DashedUnderline>，借助 <DashedUnderline effect="logos" logos={aiLogos}>AI</DashedUnderline> 实现想法，也喜欢<DashedUnderline effect="photo-stack" photos={stackPhotos}>走走拍拍</DashedUnderline>。</p><code>&lt;DashedUnderline effect="wave"&gt;动效&lt;/DashedUnderline&gt;</code><code>{'<DashedUnderline effect="photo-stack" photos={stackPhotos}>走走拍拍</DashedUnderline>'}</code></section>
    <section><SectionHeading title="字体与层级" /><div class="type-specimens"><p class="type-display">把复杂的事，设计得清楚一点。</p><p class="type-title">页面标题使用 28px、600 字重。</p><p class="type-body">界面正文与文章正文统一使用 14px；普通内容采用 1.55 行高，长文章采用 1.8 行高。English and numbers 2026.</p><p class="type-meta">说明标签 · 12PX · REGULAR</p><p class="type-script">只留一点手写痕迹。</p></div></section>
    <section><SectionHeading title="间距与圆角" /><div class="space-row">{spaces.map((space) => <div><span style={`width:var(--space-${space})`}></span><code>{space}</code></div>)}</div><div class="radius-row"><i></i><i></i><i></i><i></i></div></section>
    <section>
      <SectionHeading title="平滑圆角" description="Lisse Squircle · 60% 平滑度，保持原有圆角尺寸。左侧为普通圆角，右侧为平滑圆角；底部偏好入口可查看实际浮层。" />
      <div class="corner-comparison">
        <div><p>普通圆角 · 偏好面板</p><div class="corner-panel-demo"><span>语言</span><span>中文 / English</span><span>外观</span><span>跟随系统</span></div></div>
        <div><p>平滑圆角 · 偏好面板</p><div class="corner-panel-demo" data-smooth-corners="surface" data-smooth-shadow><span>语言</span><span>中文 / English</span><span>外观</span><span>跟随系统</span></div></div>
        <div><p>普通圆角 · 项目图片</p><img class="corner-media-demo" src="/assets/figma-v03/project-detail/cover.png" alt="" loading="lazy" /></div>
        <div><p>平滑圆角 · 项目图片</p><img class="corner-media-demo" data-smooth-corners="clip" src="/assets/figma-v03/project-detail/cover.png" alt="" loading="lazy" /></div>
      </div>
    </section>
    <section><SectionHeading title="按钮" /><div class="component-row"><Button>主要按钮</Button><Button variant="secondary">次要按钮</Button><Button variant="ghost">文字按钮</Button><Button size="small">小按钮</Button></div></section>
    <section><SectionHeading title="文字链接" description="保留低对比下划线动效；外部网站与邮件链接在悬停或键盘聚焦时展开 Feather 右上箭头，触屏与减少动态效果偏好下静态显示。" /><div class="component-row"><TextLink href="/">查看项目</TextLink><TextLink href="/writing">阅读文章</TextLink><TextLink href="https://github.com">GitHub</TextLink><TextLink href="mailto:hello@example.com">发送邮件</TextLink></div></section>
    <section><SectionHeading title="联系方式" description="可复用的联系方式组件，真实地址从职业履历读取；首页与关于页当前使用正文链接。" /><ContactLinks class="contact-links" /></section>
    <section><SectionHeading title="卡片" /><div class="project-grid"><Card><h3>标准卡片</h3><p>用于需要明确表面层级的内容。</p></Card><Card variant="quiet"><h3>安静卡片</h3><p>保留组件结构，但移除阴影和底色。</p></Card></div></section>
    <section><SectionHeading title="项目卡片" /><div class="project-grid"><ProjectCard title="复杂工作台的结构重构" summary="统一任务、资产与协作流，建立可扩展的页面骨架。" year="2026" status="已上线" accent="clay" /></div></section>
    <section><SectionHeading title="内容行" /><ContentRow title="把模糊需求变成可维护的界面" summary="行式索引优先于重卡片。" meta="2026.08.06" tags={["设计工程", "方法"]} /><ContentRow title="紧凑文章行" meta="2026.08.06" density="compact" stackOnMobile={false} /></section>
    <section><SectionHeading title="详情目录" description="文章与项目共用文字目录、滚动高亮和返回行为。" /><div class="toc-demo"><DetailToc headings={tocHeadings} ariaLabel="文章目录示例" className="detail-toc--reading detail-toc--demo" /><DetailToc headings={tocHeadings} ariaLabel="项目目录示例" className="detail-toc--reading detail-toc--demo" /></div></section>
    <section><SectionHeading title="粒子头像" description="亮色使用海边插画肖像，暗色使用像素肖像；切换主题时重新采样网点，精细指针可产生局部弹性扰动，减少动态时回退为对应的静态图像。" /><ParticlePortrait src="/assets/figma-v03/about/portrait-light.webp" alt="Leo 的海边插画肖像，黑发、黑色上衣，肩上斜挎背带，身后是蓝天和海面" darkSrc="/assets/figma-v03/about/portrait-particles.webp" darkAlt="Leo 的像素风肖像" /></section>
    <section><SectionHeading title="图片加载" description="Play Spin 点阵只用于大图产生可感知等待时；快速命中缓存时不会闪现。" /><div class="loader-demo" data-image-loading="true"><PlaySpinLoader /></div></section>
    <section><SectionHeading title="文章图片缩放" description="按下轻微缩小，松开后居中放大并模糊背景；再次点击或按 Esc 收回。" /><div data-image-zoom-demo><img class="corner-media-demo" src="/assets/figma-v03/article-detail/figma-cover.png" alt="一台手绘的老式电脑，屏幕上有放射状线条" width="2250" height="1500" /></div><ArticleImageZoom selector="[data-image-zoom-demo] img" /></section>
    <section><SectionHeading title="可拖拽照片" description="桌面端可在容器内拖拽照片，松手立即停止；移动端保留构图且关闭拖拽。" /><DraggablePhotoStack photos={photos.slice(0, 6)} /></section>
    <section><SectionHeading title="扇形照片" description="靠近照片时整体展开；指向单张时转正上移并显示标签，按住会轻微缩小。" /><PhotoFanStack photos={fanPhotos} /></section>
    <section><SectionHeading title="表单" /><form class="form-demo"><div class="field"><label for="demo-name">姓名</label><input id="demo-name" class="input" placeholder="怎么称呼你？" /></div><div class="field"><label for="demo-note">留言</label><textarea id="demo-note" class="textarea" rows="4" placeholder="写点什么……"></textarea></div><Button type="submit">发送留言</Button></form></section>
    <section>
      <SectionHeading title="渐进背景模糊" description="四层模糊从上到下逐渐增强，底部淡入当前页面背景色；切换亮暗外观可预览。底部导航使用同一组件。" />
      <div class="blur-demo">
        <div class="blur-demo__content">
          <p>内容从清晰的位置开始。</p>
          <p>向下滚动，文字逐渐融入背景。</p>
          <p>留下安静的空间，让导航保持清晰。</p>
          <TextLink href="/writing">继续阅读文章</TextLink>
        </div>
        <ProgressiveBlur />
      </div>
    </section>
    <section><SectionHeading title="布局容器" description="阅读栏 592px，常规宽栏 768px；移动端统一保留 24px gutter。" /><div class="layout-demo"><div>Wide · 768</div><div>Reading · 592</div><div>Inset</div></div></section>
  </div>
</BaseLayout>

<script>
  const updateColorValues = () => {
    const styles = getComputedStyle(document.documentElement);
    document.querySelectorAll<HTMLOutputElement>("[data-color-token]").forEach((element) => {
      const token = element.dataset.colorToken;
      if (token) element.value = styles.getPropertyValue(`--color-${token}`).trim();
    });
  };

  updateColorValues();
  new MutationObserver(updateColorValues).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>

<style>
  .ds-intro { padding-bottom: var(--space-12); }
  .ds-stack { display: grid; gap: var(--space-20); padding-bottom: var(--space-20); }
  .color-groups { display: grid; gap: var(--space-12); }
  .color-group { display: grid; gap: var(--space-5); }
  .color-group__heading { display: grid; gap: var(--space-1); }
  .color-group__heading h3 { font-size: var(--text-subhead); font-weight: var(--weight-medium); }
  .color-group__heading p { color: var(--color-muted); }
  .swatch-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: var(--space-4); }
  .swatch { display: grid; gap: var(--space-2); font-size: var(--text-xs); }
  .swatch__color { aspect-ratio: 1.5; border: 1px solid var(--color-line); border-radius: var(--radius-md); box-shadow: var(--shadow-card); }
  .swatch p { margin: 0; color: var(--color-muted); font-size: var(--text-body); line-height: var(--leading-copy); }
  .swatch output { color: var(--color-faint); font-family: var(--font-mono); font-size: var(--text-meta); }
  code { font-family: var(--font-mono); color: var(--color-copy); }
  .type-specimens { display: grid; gap: var(--space-6); }
  .type-display { font: var(--weight-semibold) var(--text-display)/var(--leading-title) var(--font-sans); letter-spacing: var(--tracking-display); }
  .type-title { font: var(--weight-semibold) var(--text-page-title)/var(--leading-title) var(--font-sans); letter-spacing: var(--tracking-title); }
  .type-body { max-width: 37rem; }
  .type-meta { color: var(--color-muted); font: var(--weight-regular) var(--text-meta)/1.5 var(--font-sans); }
  .type-script { color: var(--color-accent); font: var(--weight-regular) var(--text-page-title)/1.25 var(--font-script); }
  .space-row { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-5); }
  .space-row div { display: grid; gap: var(--space-2); }
  .space-row span { display: block; height: 2.5rem; min-width: 4px; background: var(--color-accent); }
  .radius-row { display: flex; gap: var(--space-4); margin-top: var(--space-8); }
  .radius-row i { width: 5rem; height: 3.5rem; background: var(--color-surface-2); border: 1px solid var(--color-line); }
  .radius-row i:nth-child(1) { border-radius: var(--radius-xs); }.radius-row i:nth-child(2) { border-radius: var(--radius-sm); }.radius-row i:nth-child(3) { border-radius: var(--radius-lg); }.radius-row i:nth-child(4) { border-radius: var(--radius-pill); }
  .component-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .corner-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8) var(--space-4); }
  .corner-comparison p { margin-bottom: var(--space-4); color: var(--color-muted); }
  .corner-panel-demo { position: relative; display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); padding: var(--space-3); border: 1px solid var(--color-line-subtle); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-float); }
  .corner-panel-demo:global(.has-smooth-corners) { background: transparent; border-color: transparent; box-shadow: none; overflow: visible; }
  .corner-panel-demo span:nth-child(even) { text-align: right; }
  .corner-media-demo { width: 100%; aspect-ratio: 1.96; object-fit: cover; border-radius: var(--radius-md); }
  .text-color-demo { display: grid; gap: var(--space-3); max-width: 37rem; color: var(--color-copy); font-size: 1rem; line-height: 1.7; }
  .text-color-demo .text-link { color: var(--color-link); }
  .text-color-demo code { font-size: var(--text-meta); }
  .loader-demo { position: relative; min-height: 8rem; border: 1px solid var(--color-line); background: var(--color-surface); }
  .blur-demo { position: relative; overflow: hidden; height: calc(var(--space-32) + var(--space-16)); }
  .blur-demo__content { display: grid; gap: var(--space-4); padding-block: var(--space-4); }
  .card h3 { margin-bottom: var(--space-2); font: var(--weight-medium) var(--text-title)/var(--leading-copy) var(--font-sans); }.card p { color: var(--color-muted); }
  .form-demo { max-width: 32rem; display: grid; gap: var(--space-5); }
  .form-demo .button { justify-self: start; }
  .layout-demo { padding: var(--space-4); border: 1px dashed var(--color-faint); border-radius: var(--radius-md); text-align: center; color: var(--color-muted); }
  .layout-demo div { margin-inline: auto; padding: var(--space-4); border-radius: var(--radius-sm); background: var(--color-surface-2); }
  .layout-demo div:nth-child(2) { width: 68%; margin-top: var(--space-3); background: var(--color-surface); box-shadow: var(--shadow-card); }
  .layout-demo div:nth-child(3) { width: 45%; margin-top: var(--space-3); background: var(--color-accent-soft); }
  @media(max-width:40rem){.swatch-grid,.color-rules{grid-template-columns:repeat(2,1fr)}.radius-row{display:grid;grid-template-columns:1fr 1fr}.radius-row i{width:100%}}
</style>
