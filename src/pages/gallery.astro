---
import BaseLayout from "../layouts/BaseLayout.astro";
import { galleryPlaceholders } from "../data/site";
---

<BaseLayout title="相册｜不息" description="一份按时间慢慢生长的个人照片档案。" wide>
  <header class="page-intro wide-column">
    <h1>路过一些地方，也被一些光路过。</h1>
    <p>不是完整的摄影作品集，只是认真挑选、谨慎公开的照片档案。这里不保存精确位置，也不提供原图下载。</p>
  </header>
  <section class="archive-section wide-column" aria-label="全部照片">
    <div class="gallery-grid">
      {galleryPlaceholders.map((photo) => (
        <figure class="gallery-item">
          <div class:list={["gallery-art", `tone-${photo.tone}`]} role="img" aria-label={`${photo.title}，拍摄于${photo.place}`} title={photo.title}></div>
          <figcaption><span><strong>{photo.title}</strong><br />{photo.place}</span><time>{photo.date}</time></figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
