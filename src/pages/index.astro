---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentRow from "../components/ContentRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { formatDate, projectStatusLabels } from "../lib/content";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);
const projects = (await getCollection("projects", ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
---

<BaseLayout>
  <section class="hero reading-column">
    <div class="hero__identity">
      <span class="hero__mark" aria-hidden="true">不</span>
      <div class="hero__identity-copy">
        <h1>不息</h1>
        <p>设计工程师 · 长期记录者</p>
      </div>
    </div>
    <div class="hero__copy">
      <p>你好，我是不息，一名设计工程师。我把模糊的需求整理成清晰、可维护的页面与交互。</p>
      <p>我关注页面结构、设计系统与实现细节。你可以从<a href="/projects">项目</a>开始，看看我做过的工作和背后的判断。</p>
      <p>我也在这里记录<a href="/writing">写作</a>、收藏<a href="/gallery">路上看到的光</a>，以及那些还没有完全想明白的问题。</p>
    </div>
  </section>

  <section class="home-section reading-column">
    <div class="section-topline">
      <h2>最近在想</h2>
      <a class="text-link" href="/writing">全部文章</a>
    </div>
    <div>{articles.map((article) => <ContentRow title={article.data.title} summary={article.data.description} meta={formatDate(article.data.publishedAt)} href={`/writing/${article.id}`} />)}</div>
  </section>

  <section class="home-section reading-column project-home">
    <div class="section-topline">
      <h2>精选项目</h2>
      <a class="text-link" href="/projects">项目档案</a>
    </div>
    <div class="project-grid">{projects.map((project) => <ProjectCard title={project.data.title} summary={project.data.description} year={project.data.year} status={projectStatusLabels[project.data.status]} accent={project.data.accent} href={`/projects/${project.id}`} />)}</div>
  </section>

  <section class="home-section reading-column photo-home">
    <div class="section-topline">
      <h2>最近的光</h2>
      <a class="text-link" href="/gallery">进入相册</a>
    </div>
    <div class="photo-strip" aria-label="最近摄影">
      <div class="photo-tile"><span class="photo-tile__meta"><strong>雨后的旧街</strong><small>杭州 · 2026.07</small></span></div>
      <div class="photo-tile"><span class="photo-tile__meta"><strong>午后三点</strong><small>上海 · 2026.06</small></span></div>
      <div class="photo-tile"><span class="photo-tile__meta"><strong>海边旅店</strong><small>泉州 · 2026.05</small></span></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initMotion } from "../scripts/motion";

  initMotion();
</script>
