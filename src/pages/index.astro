---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import ContentRow from "../components/ContentRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { articles, projects } from "../data/site";
---

<BaseLayout>
  <section class="hero wide-column">
    <p class="hero__kicker">你好，我是不息。</p>
    <h1><span>把复杂的事，</span><span>设计得清楚一点。</span></h1>
    <p class="hero__intro">我是一名设计工程师，关注页面结构、交互细节和长期可维护的设计系统。这里也收藏我的写作、项目与路上看到的光。</p>
    <div class="hero__actions">
      <Button href="/projects">查看工作 <span aria-hidden="true">↗</span></Button>
      <Button href="/about" variant="secondary">认识我</Button>
    </div>
    <span class="hero__orbit" aria-hidden="true"></span>
  </section>

  <section class="home-section reading-column">
    <div class="section-topline">
      <h2>最近在想</h2>
      <a class="text-link" href="/writing">全部文章</a>
    </div>
    <div>{articles.map((article) => <ContentRow title={article.title} summary={article.summary} meta={article.date} href={article.href} />)}</div>
  </section>

  <section class="home-section wide-column">
    <div class="section-topline">
      <h2>精选项目</h2>
      <a class="text-link" href="/projects">项目档案</a>
    </div>
    <div class="project-grid">{projects.slice(0, 2).map((project) => <ProjectCard {...project} />)}</div>
  </section>

  <section class="home-section wide-column">
    <div class="section-topline">
      <h2>最近的光</h2>
      <a class="text-link" href="/gallery">进入相册</a>
    </div>
    <div class="photo-strip" aria-label="最近摄影">
      <div class="photo-tile"><span class="photo-tile__meta"><strong>雨后的旧街</strong><small>杭州 · 2026.07</small></span></div>
      <div class="photo-tile"><span class="photo-tile__meta"><strong>午后三点</strong><small>上海 · 2026.06</small></span></div>
      <div class="photo-tile"><span class="photo-tile__meta"><strong>海边旅店</strong><small>泉州 · 2026.05</small></span></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initMotion } from "../scripts/motion";

  initMotion();
</script>
