---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentRow from "../components/ContentRow.astro";
import DraggablePhotoStack from "../components/DraggablePhotoStack.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TextLink from "../components/TextLink.astro";
import { getCollection, getEntry } from "astro:content";
import { galleryPhotos } from "../data/gallery";
import { formatDate } from "../lib/content";

const resume = await getEntry("resume", "main");
if (!resume) throw new Error("缺少 main 职业履历内容");
const github = resume.data.links.find((link) => link.label === "GitHub")?.href ?? "https://github.com/leoyug";
const recentArticles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime())
  .slice(0, 4);
const shuffle = <T,>(items: T[]) => [...items].sort(() => Math.random() - 0.5);
const recentPhotos = shuffle(galleryPhotos.filter((photo) => photo.orientation === "portrait")).slice(0, 6);
---

<BaseLayout>
  <section class="hero reading-column">
    <h1 class="sr-only">Leo 的个人网站</h1>
    <img class="hero__signature" src="/assets/figma/leo-mark.svg" alt="Leo" width="64" height="48" />
    <div class="hero__copy">
      <p>你好，<TextLink href="/about">我是Leo</TextLink>，一名<span class="hero-highlight" tabindex="0"><svg class="hero-highlight__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="hero-highlight__stroke" pathLength="1" d="M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074Z" /><path class="hero-highlight__stroke hero-highlight__stroke--first" pathLength="1" d="M14 4.1 12 6" /><path class="hero-highlight__stroke hero-highlight__stroke--second" pathLength="1" d="m5.1 8-2.9-.8" /><path class="hero-highlight__stroke hero-highlight__stroke--third" pathLength="1" d="m6 12-1.9 2" /><path class="hero-highlight__stroke hero-highlight__stroke--fourth" pathLength="1" d="M7.2 2.2 8 5.1" /></svg>产品设计师</span>兼兴趣体验官。</p>
      <p>我喜欢探索，好看的界面、有趣的功能、舒服的动效，以及任何用心创作的事物，这也形成了我的一些设计方式。目前我在 AI 的发展下，正在折腾一些自己的<TextLink href="/projects">项目</TextLink>。</p>
      <p>在工作之外，带着相机到处跑一跑、<TextLink href="/photos">按一按</TextLink>，也会在这里<TextLink href="/writing">记录</TextLink>生活、学习、兴趣，以及那些还没有完全想明白的问题。</p>
    </div>
  </section>

  <section class="home-section reading-column writing-home">
    <div class="section-topline"><h2>最近在想</h2></div>
    <div class="home-list">
      {recentArticles.map((article) => <ContentRow title={article.data.title} meta={formatDate(article.data.publishedAt).replaceAll(".", "-")} href={`/writing/${article.id}`} density="compact" stackOnMobile={false} />)}
    </div>
  </section>

  <section class="home-section reading-column project-home">
    <div class="section-topline"><h2>精选项目</h2></div>
    <div class="project-grid">
      <ProjectCard title="宅畅想 App" summary="家装公司全链路解决方案" year="2026" status="已上线" accent="clay" image="/assets/figma-v03/home/image-01.png" href="/projects/workspace-structure-redesign" />
      <ProjectCard title="亦我家装后台" summary="帮助企业更高效地管理资产与人员吧" year="2026" status="已上线" accent="sage" image="/assets/figma-v03/home/image-10.png" href="/projects/content-publishing-system" />
    </div>
  </section>

  <section class="home-section reading-column photo-home">
    <div class="section-topline"><h2>最近的光</h2></div>
    <DraggablePhotoStack photos={recentPhotos} label="最近的光：桌面端可拖拽照片" />
  </section>

  <section class="home-section contact-section reading-column" aria-labelledby="contact-title">
    <h2 id="contact-title">联系到我</h2>
    <nav aria-label="联系方式">
      <TextLink href={github} rel="me">GitHub</TextLink>
      <TextLink href={`mailto:${resume.data.email}`}>Email</TextLink>
      <span>微信</span>
      <TextLink href="/rss.xml">RSS</TextLink>
    </nav>
  </section>
</BaseLayout>
