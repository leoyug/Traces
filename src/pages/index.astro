---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentRow from "../components/ContentRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getEntry } from "astro:content";

const resume = await getEntry("resume", "main");
if (!resume) throw new Error("缺少 main 职业履历内容");
const github = resume.data.links.find((link) => link.label === "GitHub")?.href ?? "https://github.com/leoyug";
---

<BaseLayout>
  <section class="hero reading-column">
    <h1 class="sr-only">Leo 的个人网站</h1>
    <img class="hero__signature" src="/assets/figma/leo-mark.svg" alt="Leo" width="64" height="48" />
    <div class="hero__copy">
      <p>你好，<a href="/about">我是Leo</a>，一名产品设计师。我喜欢把模糊的需求整理成清晰的页面与交互。</p>
      <p>我关注页面结构、设计系统与实现细节。你可以从<a href="/projects">项目</a>开始，看看我做过的工作，感兴趣的话，也可以看看我的<a href="/resume">简历</a>。</p>
      <p>我也在这里记录<a href="/writing">写作</a>、收藏路上<a href="/photos">看到的光</a>，以及那些还没有完全想明白的问题。</p>
    </div>
  </section>

  <section class="home-section reading-column writing-home">
    <div class="section-topline"><h2>最近在想</h2><a class="text-link" href="/writing">全部文章</a></div>
    <div class="home-list">
      <ContentRow title="把模糊需求变成可维护的界面" meta="2026-08-06" href="/writing/clarity-before-components" density="compact" stackOnMobile={false} />
      <ContentRow title="我如何整理一座不断生长的个人档案" meta="2026-07-18" href="/writing/a-living-archive" density="compact" stackOnMobile={false} />
    </div>
  </section>

  <section class="home-section reading-column project-home">
    <div class="section-topline"><h2>精选项目</h2><a class="text-link" href="/projects">项目档案</a></div>
    <div class="project-grid">
      <ProjectCard title="宅畅想 App" summary="家装公司全链路解决方案" year="2026" status="已上线" accent="clay" image="/assets/figma-v03/home/image-01.png" href="/projects/workspace-structure-redesign" />
      <ProjectCard title="亦我家装后台" summary="帮助企业更高效地管理资产与人员吧" year="2026" status="已上线" accent="sage" image="/assets/figma-v03/home/image-10.png" href="/projects/content-publishing-system" />
    </div>
  </section>

  <section class="home-section reading-column photo-home">
    <div class="section-topline"><h2>最近的光</h2><a class="text-link" href="/photos">进入相册</a></div>
    <div class="photo-strip" aria-label="最近摄影">
      <a href="/photos/public-phone/" aria-label="查看照片：暮色建筑"><img src="/assets/figma-v03/home/image-02.jpg" alt="暮色中的建筑与行人" /></a>
      <a href="/photos/park-walk/" aria-label="查看照片：公园散步"><img src="/assets/figma-v03/home/image-04.jpg" alt="冬日公园里散步的人" /></a>
      <a href="/photos/cranes-at-dusk/" aria-label="查看照片：暮色塔吊"><img src="/assets/figma-v03/home/image-05.jpg" alt="暮色天空下的塔吊" /></a>
    </div>
  </section>

  <section class="home-section contact-section reading-column" aria-labelledby="contact-title">
    <h2 id="contact-title">联系到我</h2>
    <nav aria-label="联系方式">
      <a href={github} rel="me">GitHub</a>
      <a href={`mailto:${resume.data.email}`}>Email</a>
      <span>微信</span>
      <a href="/rss.xml">RSS</a>
    </nav>
  </section>
</BaseLayout>
