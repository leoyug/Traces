---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentRow from "../components/ContentRow.astro";
import ContactLinks from "../components/ContactLinks.astro";
import DraggablePhotoStack from "../components/DraggablePhotoStack.astro";
import PhotoFanStack from "../components/PhotoFanStack.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TextLink from "../components/TextLink.astro";
import { getCollection } from "astro:content";
import { getProjects, projectPreview } from "../lib/projects";
import { getPhotos } from "../lib/photos";
import { formatDate } from "../lib/content";

const photos = await getPhotos();
const recentArticles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime())
  .slice(0, 4);
const featuredProjectPreviews = (await getProjects()).filter((project) => project.data.featured).map(projectPreview);
const homeFanPhotoLabels = ["夜行", "栈桥", "帐篷", "散步", "晚风", "树影", "远望"];
const homeFanPhotos = photos.slice(0, 7).map((photo, index) => ({
  photo,
  label: homeFanPhotoLabels[index],
}));
const shuffle = <T,>(items: T[]) => [...items].sort(() => Math.random() - 0.5);
const recentPhotos = shuffle(photos.filter((photo) => photo.orientation === "portrait")).slice(0, 6);
---

<BaseLayout>
  <section class="hero reading-column">
    <h1 class="sr-only">Leo 的个人网站</h1>
    <img class="hero__signature" src="/assets/figma/leo-mark.svg" alt="Leo" width="64" height="48" data-route-enter />
    <div class="hero__copy">
      <p data-route-enter>这里是 <TextLink href="/about">Leo</TextLink> 的数字花园。</p>
      <p data-route-enter>可以在这里找到我正在折腾的<TextLink href="/projects">项目</TextLink>。</p>
      <p data-route-enter>也可以探索我正在记录的<TextLink href="/writing">文字</TextLink>和<TextLink href="/photos">影像</TextLink>，关于生活、工作、兴趣和没想明白的问题。</p>
    </div>
  </section>

  <section class="home-section reading-column writing-home">
    <div class="section-topline" data-route-enter><h2>最近在想</h2></div>
    <div class="home-list" data-route-enter-group>
      {recentArticles.map((article) => <ContentRow title={article.data.title} meta={formatDate(article.data.publishedAt).replaceAll(".", "-")} href={`/writing/${article.id}`} density="compact" stackOnMobile={false} />)}
    </div>
  </section>

  <section class="home-section reading-column project-home">
    <div class="section-topline" data-route-enter><h2>精选项目</h2></div>
    <div class="project-grid" data-route-enter-group>
      {featuredProjectPreviews.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <section class="home-section reading-column photo-home" data-route-enter>
    <div class="section-topline"><h2>屏幕之外</h2></div>
    <div class="photo-home__variant photo-home__variant--fan">
      <PhotoFanStack photos={homeFanPhotos} label="屏幕之外：悬停展开照片" />
    </div>
    <div class="photo-home__variant photo-home__variant--drag">
      <DraggablePhotoStack photos={recentPhotos} label="屏幕之外：桌面端可拖拽照片" />
    </div>
  </section>

  <section class="home-section contact-section reading-column" aria-labelledby="contact-title" data-route-enter>
    <div class="section-topline"><h2 id="contact-title">联系到我</h2></div>
    <ContactLinks />
  </section>
</BaseLayout>
