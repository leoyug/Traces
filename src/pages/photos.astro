---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotosPage from "../components/photos/PhotosPage.astro";
import { getPhotos } from "../lib/photos";

const photos = await getPhotos();
if (photos.length === 0) return Astro.redirect("/");
---

<BaseLayout title="摄影｜Leo" description="沿途看见的光。" robots="noindex,follow">
  <PhotosPage photos={photos} />
</BaseLayout>
