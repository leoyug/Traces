---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FigmaGallery from "../../components/photos/FigmaGallery.astro";
import { galleryPhotos } from "../../data/gallery";

export async function getStaticPaths() {
  return galleryPhotos.map((photo) => ({ params: { id: photo.slug }, props: { photo } }));
}
interface Props { photo: (typeof galleryPhotos)[number] }
const { photo } = Astro.props;
---

<BaseLayout title={`摄影｜Leo`} description={photo.alt} socialImage={photo.src} robots="noindex,follow">
  <FigmaGallery initialSlug={photo.slug} />
</BaseLayout>
