---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotosPage from "../../components/photos/PhotosPage.astro";
import { getPhotos, type Photo } from "../../lib/photos";

export async function getStaticPaths() {
  const photos = await getPhotos();
  return photos.map((photo) => ({ params: { id: photo.slug }, props: { photo, photos } }));
}
interface Props { photo: Photo; photos: Photo[] }
const { photo, photos } = Astro.props;
---

<BaseLayout title={`摄影｜Leo`} description={photo.alt} socialImage={photo.src} robots="noindex,follow">
  <PhotosPage photos={photos} initialSlug={photo.slug} />
</BaseLayout>
