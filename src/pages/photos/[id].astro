---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoGallery from "../../components/photos/PhotoGallery.astro";
import { getGalleryPhotos, type GalleryPhoto } from "../../lib/gallery";

export async function getStaticPaths() {
  const photos = await getGalleryPhotos();
  return photos.map((photo) => ({ params: { id: photo.slug }, props: { photo, photos } }));
}
interface Props { photo: GalleryPhoto; photos: GalleryPhoto[] }
const { photo, photos } = Astro.props;
---

<BaseLayout title={`摄影｜Leo`} description={photo.alt} socialImage={photo.src} robots="noindex,follow">
  <PhotoGallery photos={photos} initialSlug={photo.slug} />
</BaseLayout>
