---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoMeta from "../../components/photos/PhotoMeta.astro";
import PhotoPicture from "../../components/photos/PhotoPicture.astro";
import { getPhotoLibrary } from "../../lib/photos";
import type { PhotoListItem } from "../../lib/photo-types";

export async function getStaticPaths() {
  const { photos } = await getPhotoLibrary();
  return photos.map((photo) => ({ params: { id: photo.slug }, props: { photo, photos } }));
}

interface Props { photo: PhotoListItem; photos: PhotoListItem[] }
const { photo, photos } = Astro.props;
const index = photos.findIndex((item) => item.slug === photo.slug);
const previous = photos[index - 1];
const next = photos[index + 1];
const socialImage = photo.sources.jpeg.at(-1)?.src ?? null;
---

<BaseLayout title={`${photo.title}｜Leo 的照片`} description={photo.description} wide socialImage={socialImage} robots="noindex,follow">
  <article class="photo-detail">
    <div class="photo-detail__bar wide-column">
      <a href="/photos/" class="text-link" data-photo-return>返回全部照片</a>
      <span>{index + 1} / {photos.length}</span>
    </div>
    <div class="photo-detail__layout wide-column">
      <figure class="photo-detail__image" style={`--photo-placeholder:${photo.placeholder}`}>
        <PhotoPicture photo={photo} loading="eager" fetchpriority="high" sizes="(max-width: 768px) 100vw, calc(100vw - 420px)" />
      </figure>
      <aside class="photo-detail__meta"><PhotoMeta photo={photo} heading="h1" /></aside>
    </div>
    <nav class="photo-detail__navigation wide-column" aria-label="相邻照片">
      {previous ? <a href={`/photos/${previous.slug}/`} rel="prev">← {previous.title}</a> : <span></span>}
      {next && <a href={`/photos/${next.slug}/`} rel="next">{next.title} →</a>}
    </nav>
  </article>
</BaseLayout>

<script>
  const returnLink = document.querySelector<HTMLAnchorElement>("[data-photo-return]");
  if (returnLink) {
    const params = new URLSearchParams(location.search);
    const context = params.get("context");
    const value = params.get("value");
    const batch = params.get("batch");
    const target = context === "album" && value
      ? `/albums/${encodeURIComponent(value)}/`
      : context === "tag" && value
        ? `/photos/tags/${encodeURIComponent(value)}/`
        : "/photos/";
    const url = new URL(target, location.origin);
    if (batch && Number(batch) > 1) url.searchParams.set("batch", batch);
    returnLink.href = `${url.pathname}${url.search}`;
    returnLink.textContent = context === "album" ? "返回相册" : context === "tag" ? "返回标签" : "返回全部照片";
  }
</script>
