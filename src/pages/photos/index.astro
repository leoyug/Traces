---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PhotoGrid from "../../components/photos/PhotoGrid.astro";
import PhotoPicture from "../../components/photos/PhotoPicture.astro";
import { getPhotoLibrary } from "../../lib/photos";

const { photos, albums } = await getPhotoLibrary();
---

<BaseLayout title="相册｜Leo" description="一份按时间慢慢生长、谨慎公开的个人照片档案。" wide robots="noindex,follow">
  <header class="photo-index-header reading-column">
    <h1>路过一些地方，也被一些光路过。</h1>
    <p>这里不是完整的摄影作品集，只收藏认真挑选、确认可以公开的片段。照片不包含精确位置，也不提供原件下载。</p>
  </header>

  {albums.length > 0 && (
    <section class="photo-albums reading-column" aria-labelledby="albums-title">
      <div class="section-topline">
        <h2 id="albums-title">相册</h2>
        <span>{albums.length} 本</span>
      </div>
      <div class="photo-album-list">
        {albums.map(({ entry, cover, photos: albumPhotos }) => (
          <a class="photo-album-row" href={`/albums/${entry.id}/`}>
            {cover && <span class="photo-album-row__cover"><PhotoPicture photo={cover} sizes="72px" /></span>}
            <span class="photo-album-row__copy"><strong>{entry.data.title}</strong><small>{entry.data.description}</small></span>
            <span class="photo-album-row__count">{albumPhotos.length} 张</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="photo-archive-header wide-column">
    <h2>全部照片</h2>
    <span>{photos.length} 张</span>
  </div>
  <PhotoGrid photos={photos} context={{ type: "all" }} label="全部照片" demo />
</BaseLayout>
