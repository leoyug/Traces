---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { archiveProjectPreviews, featuredProjectPreviews } from "../data/project-previews";

const archiveAsset = (name: string) => `/assets/figma-v03/projects/archive/${name}`;
---

<BaseLayout title="项目｜Leo" description="产品设计项目档案。">
  <header class="page-intro reading-column">
    <h1 data-route-enter>项目</h1>
    <p data-route-enter>设计项目的过程中，我思考最多的往往是使用时的体验。</p>
  </header>
  <section class="archive-section featured-projects reading-column" aria-labelledby="featured-title">
    <div class="section-topline" data-route-enter><h2 id="featured-title">精选项目</h2></div>
    <div class="project-grid" data-route-enter-group>
      {featuredProjectPreviews.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
  <section class="archive-section reading-column" aria-labelledby="archive-title">
    <div class="section-topline" data-route-enter><h2 id="archive-title">全部项目</h2></div>
    <div class="project-archive-list" data-project-archive-list data-route-enter-group>
      {archiveProjectPreviews.map((project) =>
        <a class="project-archive-row" href={project.href} data-project-transition data-project-source={project.source}>
          <span class="project-archive-row__thumb" aria-hidden="true">
            {project.images.map((image) => <img src={archiveAsset(image)} alt="" loading="lazy" />)}
          </span>
          <span class="project-archive-row__copy"><strong>{project.title}</strong><small>{project.summary}</small></span>
          <time>{project.year}</time>
        </a>)}
    </div>
  </section>
  <script>
    const initializeProjectTransitions = () => {
      const links = document.querySelectorAll<HTMLElement>("[data-project-transition]");
      const featuredLinks = document.querySelectorAll<HTMLElement>(".featured-projects .project-card");

      links.forEach((link) => {
        if (link.dataset.transitionReady === "true") return;
        link.dataset.transitionReady = "true";

        const markAsSource = (event: MouseEvent | PointerEvent) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          links.forEach((item) => item.classList.remove("is-transitioning"));
          featuredLinks.forEach((item) => item.classList.remove("is-transitioning"));
          link.classList.add("is-transitioning");
          const source = link.dataset.projectSource;
          if (source) sessionStorage.setItem("project-transition-source", source);
        };

        link.addEventListener("pointerdown", markAsSource, { passive: true });
        link.addEventListener("click", markAsSource);
      });

      featuredLinks.forEach((link) => {
        if (link.dataset.transitionReady === "true") return;
        link.dataset.transitionReady = "true";

        const clearSource = (event: MouseEvent | PointerEvent) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const anchor = (event.target as Element).closest<HTMLAnchorElement>("a[href]");
          if (!anchor || !link.contains(anchor)) return;

          links.forEach((item) => item.classList.remove("is-transitioning"));
          featuredLinks.forEach((item) => item.classList.remove("is-transitioning"));
          link.classList.add("is-transitioning");
          const href = anchor.getAttribute("href");
          if (href) sessionStorage.setItem("project-transition-source", `featured:${href}`);
        };

        link.addEventListener("pointerdown", clearSource, { passive: true });
        link.addEventListener("click", clearSource);
      });
    };

    const finishProjectTransition = () => {
      const list = document.querySelector("[data-project-archive-list]");
      if (!list) return;

      // Keep the source marked for the return snapshot, then restore the idle stack.
      requestAnimationFrame(() => {
        list.querySelectorAll(".is-transitioning").forEach((row) => row.classList.remove("is-transitioning"));
        document.querySelectorAll(".featured-projects .project-card.is-transitioning").forEach((card) => card.classList.remove("is-transitioning"));
        sessionStorage.removeItem("project-transition-source");
      });
    };

    initializeProjectTransitions();
    document.addEventListener("astro:page-load", () => {
      initializeProjectTransitions();
      finishProjectTransition();
    });
    document.addEventListener("astro:before-swap", (event) => {
      const source = sessionStorage.getItem("project-transition-source");
      if (!source) return;

      if (source.startsWith("featured:")) {
        const href = source.slice("featured:".length);
        const card = Array.from(event.newDocument.querySelectorAll<HTMLElement>(".featured-projects .project-card"))
          .find((item) => item.querySelector<HTMLAnchorElement>("a[href]")?.getAttribute("href") === href);
        card?.classList.add("is-transitioning");
        return;
      }

      const selector = `[data-project-source="${CSS.escape(source)}"]`;
      event.newDocument.querySelector(selector)?.classList.add("is-transitioning");
    });
  </script>
</BaseLayout>
