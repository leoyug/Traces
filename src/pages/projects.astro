---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projectStackStyle } from "../lib/project-stack";
import { getProjects, projectPreview } from "../lib/projects";

const projects = await getProjects();
const featuredProjectPreviews = projects.filter((project) => project.data.featured).map(projectPreview);
const archiveProjectPreviews = projects.map((project) => ({
  source: project.id,
  title: project.data.title,
  summary: project.data.description,
  year: String(project.data.year),
  images: Array.from({ length: 3 }, (_, index) => project.data.archiveImages[index] ?? project.data.cover ?? "/assets/figma-v03/project-detail/cover.png"),
  href: `/projects/${project.id}`,
}));
---

<BaseLayout title="项目｜Leo" description="产品设计项目档案。">
  <header class="page-intro reading-column">
    <h1 data-route-enter>项目</h1>
    <p data-route-enter>设计项目的过程中，我思考最多的往往是使用时的体验。</p>
  </header>
  <section class="archive-section featured-projects reading-column" aria-labelledby="featured-title">
    <div class="section-topline" data-route-enter><h2 id="featured-title">精选项目</h2></div>
    <div class="project-grid" data-route-enter-group>
      {featuredProjectPreviews.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>
  <section class="archive-section reading-column" aria-labelledby="archive-title">
    <div class="section-topline" data-route-enter><h2 id="archive-title">全部项目</h2></div>
    <div class="project-archive-list" data-project-archive-list data-route-enter-group>
      {archiveProjectPreviews.map((project) =>
        <a class="project-archive-row" href={project.href} data-list-sound data-project-transition data-project-source={project.source}>
          <span class="project-archive-row__thumb" aria-hidden="true">
            {project.images.map((image, index) => <img src={image} alt="" loading="lazy" style={projectStackStyle(project.source, index)} />)}
          </span>
          <span class="project-archive-row__copy"><strong>{project.title}</strong><small>{project.summary}</small></span>
          <time>{project.year}</time>
        </a>)}
    </div>
  </section>
</BaseLayout>
