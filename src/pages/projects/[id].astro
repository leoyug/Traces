---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import DetailToc from "../../components/DetailToc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, projectStatusLabels } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<"projects">; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const cover = entry.data.cover ?? "/assets/figma-v03/project-detail/cover.png";
---

<BaseLayout title={`${entry.data.title}｜Leo`} description={entry.data.description} socialImage={cover}>
  <DetailToc headings={headings} ariaLabel="项目目录" backHref="/projects" backLabel="返回项目" returnViaHistory />
  <article class="content-detail reading-column" data-detail-page="project">
    <img class="content-detail__cover" src={cover} alt="" transition:name="project-cover" />
    <header id="overview" data-route-enter>
      <h1>{entry.data.title}</h1>
      <dl class="detail-facts">
        <div><dt>年份</dt><dd>{entry.data.year}</dd></div>
        <div><dt>角色</dt><dd>{entry.data.role}</dd></div>
        <div><dt>状态</dt><dd>{projectStatusLabels[entry.data.status]}</dd></div>
        <div><dt>日期</dt><dd>{formatDate(entry.data.publishedAt)}</dd></div>
      </dl>
    </header>
    <div class="article__body" id="content" data-route-enter-body><Content /></div>
    <span id="reflection" class="detail-anchor" aria-hidden="true"></span>
  </article>
</BaseLayout>
