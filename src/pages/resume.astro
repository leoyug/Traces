---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const resume = await getEntry("resume", "main");
if (!resume) throw new Error("缺少 main 职业履历内容");
const { data } = resume;
---

<BaseLayout title={`${data.name}｜在线履历`} description={`${data.name}的职业经历、项目经验与技能。`}>
  <article class="resume reading-column">
    <header class="resume__intro">
      <h1>{data.name}</h1>
      <p>Hi，我是{data.name} / {data.publicName}，一名{data.title}。{data.summary}</p>
      <p>工作之外，我也喜欢摄影、写作和美食。你可以继续查看我的<a href="/projects">项目档案</a>，或直接通过邮箱联系我。</p>
      <nav class="resume__contacts" aria-label="履历联系方式">
        <a href="/">incessantleo.com</a>
        <a href={`mailto:${data.email}`}>{data.email}</a>
        {data.links.filter((link) => link.label !== "网站").map((link) => <a href={link.href} rel="me">{link.label}</a>)}
      </nav>
    </header>

    <section class="resume__section">
      <h2>工作经历</h2>
      <ol class="resume-timeline">
        {data.experience.map((item) => (
          <li><time>{item.period}</time><div><h3>{item.organization} <span>{item.role}</span></h3><p>{item.summary}</p></div></li>
        ))}
      </ol>
    </section>

    {data.projects.length > 0 && <section class="resume__section">
      <h2>项目经验</h2>
      <div class="resume-projects">
        {data.projects.map((project) => <article><h3>{project.name}</h3><p>{project.summary}</p><ul aria-label="项目标签">{project.tags.map((tag) => <li>{tag}</li>)}</ul></article>)}
      </div>
    </section>}

    {data.skills.length > 0 && <section class="resume__section">
      <h2>技能与工具</h2>
      <div class="resume-skills">
        {data.skills.map((group) => <section><h3>{group.label}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></section>)}
      </div>
    </section>}

    {data.education && <section class="resume__section">
      <h2>教育经历</h2>
      <div class="resume-education"><div><h3>{data.education.school}</h3><p>{data.education.degree}</p></div><div><time>{data.education.period}</time><p>{data.education.place}</p></div></div>
    </section>}
  </article>
</BaseLayout>
