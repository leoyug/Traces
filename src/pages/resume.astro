---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const resume = await getEntry("resume", "main");
if (!resume) throw new Error("缺少 main 职业履历内容");
const { data } = resume;
---

<BaseLayout title={`${data.name}｜在线履历`} description={`${data.name}的职业经历、项目经验与技能。`}>
  <article class="resume reading-column">
    <header class="resume__intro">
      <div class="resume__heading">
        <h1>{data.name}</h1>
        <div class="resume__summary">
          <p>Hi，我是廖如晟/Leo，一名产品设计师。我热衷于体验有趣的应用或者产品，也爱探索各种有趣的设计和博客。</p>
          <p>我从事设计工作是出于自己的兴趣，在经历了快 3 年的研究所工作后，我发现还是设计工作比较能让我投入。之前是在一家VR 看房行业的设计岗工作，做过 App 产品设计、B 端后台设计、Web 端页面设计；使用过 Sketch、Figma、Adobe 套件等相关工具；也热衷于探索将 AI 融入工作流，尝试使用 Agent 开发个人产品。</p>
          <p>在工作之外，也喜欢折腾各种感兴趣的东西，比如摄影、博客、美食。</p>
          <p>可以下载我的<a href="/resume">简历</a>，也可以查看我的<a href="/projects">在线作品集</a>或者<a href="/resume">PDF 文件</a>。</p>
        </div>
      </div>
      <nav class="resume__contacts" aria-label="履历联系方式">
        <a href="/"><img src="/assets/figma-v03/detail/resume-web.svg" alt="" />incessantleo.com</a>
        <a href={`mailto:${data.email}`}><img src="/assets/figma-v03/detail/resume-email.svg" alt="" />{data.email}</a>
        <a href="https://github.com/leoyug" rel="me"><img src="/assets/figma-v03/detail/resume-github.svg" alt="" />github.com/leoyug</a>
      </nav>
    </header>

    <section class="resume__section">
      <h2>工作经历</h2>
      <ol class="resume-timeline">
        {data.experience.map((item) => (
          <li><time>{item.period.replace("—", "-")}</time><div><h3>{item.organization} <span>{item.role}</span></h3></div></li>
        ))}
      </ol>
    </section>

    {data.projects.length > 0 && <section class="resume__section">
      <h2>项目经验</h2>
      <div class="resume-projects">
        {data.projects.map((project) => <article><h3>{project.name}</h3><p>{project.summary}</p><ul aria-label="项目标签">{project.tags.map((tag) => <li>{tag}</li>)}</ul></article>)}
      </div>
    </section>}

    {data.skills.length > 0 && <section class="resume__section">
      <h2>技能与工具</h2>
      <div class="resume-skills">
        {data.skills.map((group) => <section><h3>{group.label}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></section>)}
      </div>
    </section>}

    {data.education && <section class="resume__section">
      <h2>教育经历</h2>
      <div class="resume-education"><div><h3>{data.education.school}</h3><p>{data.education.degree}</p></div><div><time>{data.education.period}</time><p>{data.education.place}</p></div></div>
    </section>}
  </article>
</BaseLayout>
