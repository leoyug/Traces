---
import BaseLayout from "../layouts/BaseLayout.astro";
import TextLink from "../components/TextLink.astro";
import Card from "../components/Card.astro";
import { getEntry } from "astro:content";

const resume = await getEntry("resume", "main");
if (!resume) throw new Error("缺少 main 职业履历内容");
const { data } = resume;
const website = data.links.find((link) => link.label === "网站")?.href;
const github = data.links.find((link) => link.label === "GitHub")?.href;
---

<BaseLayout title="简历｜Leo" description={`${data.name}的职业经历、项目经验与技能。`}>
  <article class="resume reading-column">
    <h1 class="resume__page-title">简历</h1>
    <header class="resume__intro">
      <div class="resume__heading">
        <h2 class="resume__name">{data.name}</h2>
        <div class="resume__summary">
          {data.introduction.map((paragraph) => <p>{paragraph}</p>)}
          <p>可以下载我的<TextLink href="/resume">简历</TextLink>，查看我的<TextLink href="/projects">在线作品集</TextLink>或者<TextLink href="/resume">PDF 文件</TextLink>。</p>
        </div>
      </div>
      <nav class="resume__contacts" aria-label="履历联系方式">
        {website && <a href={website}><span class="resume__contact-icon resume__contact-icon--web" aria-hidden="true"></span>{new URL(website).hostname}</a>}
        <a href={`mailto:${data.email}`}><span class="resume__contact-icon resume__contact-icon--mail" aria-hidden="true"></span>{data.email}</a>
        {github && <a href={github} rel="me"><span class="resume__contact-icon resume__contact-icon--github" aria-hidden="true"></span>{github.replace(/^https?:\/\//, "")}</a>}
      </nav>
    </header>

    <section class="resume__section">
      <h2>工作经历</h2>
      <ol class="resume-timeline">
        {data.experience.map((item, index) => (
          <li>
            {index < data.experience.length - 1 && <img class="resume-timeline__line" src="/assets/figma-v03/resume/timeline-line.svg" alt="" width="1" height="136" />}
            <img class="resume-timeline__dot" src="/assets/figma-v03/resume/timeline-dot.svg" alt="" width="10" height="10" />
            <time>{item.period.replace("—", "-")}</time>
            <div class="resume-timeline__position">
              <h3>{item.organization}</h3>
              <p class="resume-timeline__role">{item.role}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {data.projects.length > 0 && <section class="resume__section">
      <h2>项目经验</h2>
      <div class="resume-projects">
        {data.projects.map((project) => <article><h3>{project.name}</h3><p>{project.summary}</p><ul aria-label="项目标签">{project.tags.map((tag) => <li>{tag}</li>)}</ul></article>)}
      </div>
    </section>}

    {data.skills.length > 0 && <section class="resume__section">
      <h2>技能&amp;工具</h2>
      <div class="resume-skills">
        {data.skills.map((group) => <Card class="resume-skills__group"><h3>{group.label}</h3><ul>{group.items.map((item) => <li>{item}</li>)}</ul></Card>)}
      </div>
    </section>}

    {data.education && <section class="resume__section">
      <h2>教育经历</h2>
      <Card class="resume-education"><div><h3>{data.education.school}</h3><p>{data.education.degree.replaceAll(" ", "")}</p></div><div><time>{data.education.period.replace("—", "-")}</time><p>{data.education.place}</p></div></Card>
    </section>}
  </article>
</BaseLayout>
