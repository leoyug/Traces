---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentRow from "../components/ContentRow.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../lib/content";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((left, right) => right.data.publishedAt.getTime() - left.data.publishedAt.getTime());
const groups = [...articles.reduce((years, article) => {
  const year = String(article.data.publishedAt.getFullYear());
  years.set(year, [...(years.get(year) ?? []), article]);
  return years;
}, new Map<string, typeof articles>()).entries()];
---

<BaseLayout title="写作｜Leo" description="生活、设计与学习记录。">
  <header class="page-intro reading-column"><h1>写作</h1><p>我写作是为了让自己记得当下的感受以及帮助自己学习。有些可能只是琐事，也有值得记录的生活。</p></header>
  {groups.map(([year, entries]) => <section class="archive-section writing-year reading-column" aria-labelledby={`year-${year}`}><div class="section-topline"><h2 id={`year-${year}`}>{year}</h2></div><div>{entries.map((article) => <ContentRow title={article.data.title} meta={formatDate(article.data.publishedAt).slice(5).replace(".", "-")} href={`/writing/${article.id}`} density="compact" stackOnMobile={false} />)}</div></section>)}
</BaseLayout>
