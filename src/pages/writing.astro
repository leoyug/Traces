---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentRow from "../components/ContentRow.astro";
import { articles } from "../data/site";
---

<BaseLayout title="文章｜不息" description="关于设计工程、个人档案和日常观察的写作。">
  <header class="page-intro reading-column">
    <p class="eyebrow">Notes & essays</p>
    <h1>写作，是把尚未成形的想法放到桌面上。</h1>
    <p>主要写设计工程、产品判断和长期记录。偶尔也写一段散步、一张照片，或者最近没有想通的问题。</p>
  </header>
  <section class="archive-section reading-column" aria-labelledby="writing-2026">
    <div class="section-topline"><div><p class="eyebrow">Archive</p><h2 id="writing-2026">2026</h2></div><a class="text-link" href="/rss.xml">RSS</a></div>
    {articles.map((article) => <ContentRow title={article.title} summary={article.summary} meta={article.date} href={article.href} tags={article.tags} />)}
  </section>
</BaseLayout>
